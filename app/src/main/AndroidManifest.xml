<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Live map tiles (OpenFreeMap), weather (Open-Meteo, coordinates rounded
        to ~1 km) and http(s) artwork URLs supplied by media sessions. The
        launcher itself and the navigation hand-off work fully offline.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        AutoVerse Remote (optional, off by default): when the driver turns it
        on in Car → Phone, a small local web server answers the driver's phone
        on the unit's own Wi-Fi/hotspot network, guarded by a pairing code.
        It uses the INTERNET permission above; nothing is reachable from the
        internet and nothing runs while the switch is off.
    -->

    <!--
        Dashboard status indicators: reading the active network transport.
        Install-time, no prompt.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Bluetooth status indicator below API 31: the legacy BLUETOOTH
        permission is install-time and declared only for API 23-30. On API
        31+ the adapter state would need BLUETOOTH_CONNECT, which the
        launcher deliberately never requests — the indicator stays hidden
        there and reports UNKNOWN.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!--
        Tier 2 (OBD): talking to a bonded ELM327 adapter over RFCOMM needs
        BLUETOOTH_CONNECT on API 31+. Runtime-requested only when the user
        taps "Connect adapter"; never used for scanning or discovery.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        Foreground GPS only, while AutoVerse is on screen: live-map position,
        speed readout and weather. Requested from onboarding (with an
        explanation) or the speed panel's "Allow location". Never stored or
        sent anywhere except the rounded weather lookup; navigation hand-off
        never receives coordinates it did not get from the typed destination.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        Incoming-call panel on Home (0.28.0): READ_PHONE_STATE only, runtime
        opt-in from the Home side panel, callbacks read only while Home is
        visible. No call-log, contacts, or phone access; the number shown is
        whatever the platform supplies with this permission, nothing more.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
        Music page (1.3.0): AutoVerse's own player for songs on the unit, an
        SD card or a USB drive. Reading audio files only (no photos/videos);
        requested from car setup or the Music page, optional. The player runs
        as a media-playback foreground service so music continues while the
        driver uses other apps.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Car page > Head unit check (1.5.0): optional Usage access, granted by
        the user in system settings, so the check can list the busiest apps
        and apps unused for 30+ days. Only foreground time is read.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Shizuku (map-display probe) declares minSdk 24 conservatively; the
        library itself works on 23 and every Shizuku call in the app is
        guarded, so the merge is overridden rather than dropping an API-23
        device class.
    -->
    <uses-sdk tools:overrideLibrary="rikka.shizuku.api" />

    <!--
        Package visibility (API 30+): the app drawer queries launcher-intent
        activities. This <queries> block scopes visibility to exactly the
        apps that declare a launcher activity; no QUERY_ALL_PACKAGES needed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!--
            Category chips (Phase 15): each CATEGORY_APP_* value is probed
            once per app-list refresh to classify apps whose declared
            ApplicationInfo.category is missing or unmapped (games, images,
            news). These entries extend the launcher query above; they never
            grant visibility beyond category-hinted launcher activities, and
            QUERY_ALL_PACKAGES is still deliberately absent.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MAPS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MESSAGING" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_EMAIL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CONTACTS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALCULATOR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_GALLERY" />
        </intent>

        <!--
            Navigation hand-off (API 30+): geo-intent visibility for
            destination discovery, plus the two apps with documented URI
            formats that are probed by package name.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />

        <!-- Car → Phone: says whether Spotify Connect is ready on this unit. -->
        <package android:name="com.spotify.music" />

        <!--
            Music page: apps that offer their library to car systems through
            the standard media browser service (Spotify, JioSaavn, Poweramp…).
        -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>

        <!-- Shizuku: virtual-display helper (map region probe). -->
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="rikka.sui" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoVerse">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            tools:targetApi="24">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!--
                Places from other apps: Google Maps "Share → AutoVerse" (text
                with a maps link), geo: links, and Google Maps links opened
                from messages — AutoVerse then navigates on its own map.
            -->
            <intent-filter android:label="Navigate with AutoVerse">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="Navigate with AutoVerse">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
            <intent-filter android:label="Navigate with AutoVerse">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="maps.app.goo.gl" />
                <data android:host="maps.google.com" />
            </intent-filter>
            <intent-filter android:label="Navigate with AutoVerse">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.google.com" />
                <data android:host="google.com" />
                <data android:pathPrefix="/maps" />
            </intent-filter>
        </activity>

        <!--
            Binds as a notification listener solely because the platform gates
            media-session access behind that binding. The implementation is
            empty: notifications are never read, stored, or forwarded.
        -->
        <service
            android:name=".core.media.AutoVerseMediaListenerService"
            android:exported="true"
            android:label="@string/media_access_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".core.music.AutoVersePlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

            <!-- Shizuku provider: lets AutoVerse talk to the Shizuku app
             (shell privileges via wireless debugging) for the map-display
             probe. No effect unless the user grants it. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
