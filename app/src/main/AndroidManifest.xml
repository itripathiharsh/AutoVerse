<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Cockpit WebView only: Leaflet map tiles, Nominatim geocoding, and
        http(s) artwork URLs from media sessions. The launcher itself and the
        navigation hand-off work fully offline.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Dashboard status indicators: reading the active network transport.
        Install-time, no prompt.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Bluetooth status indicator below API 31: the legacy BLUETOOTH
        permission is install-time and declared only for API 23-30. On API
        31+ the adapter state would need BLUETOOTH_CONNECT, which the
        launcher deliberately never requests — the indicator stays hidden
        there and reports UNKNOWN.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!--
        Tier 2 (OBD): talking to a bonded ELM327 adapter over RFCOMM needs
        BLUETOOTH_CONNECT on API 31+. Runtime-requested only when the user
        taps "Connect adapter"; never used for scanning or discovery.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        Tier 2 (offline voice): on-device wake-word recognition runs only
        while the app is foregrounded and only after the user opts in from
        Settings. Audio never leaves the device (Vosk is fully local).
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Cockpit live GPS only (map position, recenter, speed readout). The
        WebView geolocation prompt is granted for the cockpit origin, and
        MainActivity requests the runtime grant on first launch. No other
        surface reads location; navigation hand-off never receives
        coordinates it did not get from the user's typed destination.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        Incoming-call panel on Home (0.28.0): READ_PHONE_STATE only, runtime
        opt-in from the Home side panel, callbacks read only while Home is
        visible. No call-log, contacts, or phone access; the number shown is
        whatever the platform supplies with this permission, nothing more.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
        Shizuku (map-display probe) declares minSdk 24 conservatively; the
        library itself works on 23 and every Shizuku call in the app is
        guarded, so the merge is overridden rather than dropping an API-23
        device class.
    -->
    <uses-sdk tools:overrideLibrary="rikka.shizuku.api" />

    <!--
        Package visibility (API 30+): the app drawer queries launcher-intent
        activities. This <queries> block scopes visibility to exactly the
        apps that declare a launcher activity; no QUERY_ALL_PACKAGES needed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!--
            Category chips (Phase 15): each CATEGORY_APP_* value is probed
            once per app-list refresh to classify apps whose declared
            ApplicationInfo.category is missing or unmapped (games, images,
            news). These entries extend the launcher query above; they never
            grant visibility beyond category-hinted launcher activities, and
            QUERY_ALL_PACKAGES is still deliberately absent.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MAPS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MESSAGING" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_EMAIL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CONTACTS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALCULATOR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_GALLERY" />
        </intent>

        <!--
            Navigation hand-off (API 30+): geo-intent visibility for
            destination discovery, plus the two apps with documented URI
            formats that are probed by package name.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />

        <!--
            Onboarding (Tier 1): resolves the device speech service so the
            voice-assistant row shows real availability instead of a guess.
        -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- Shizuku: virtual-display helper (map region probe). -->
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="rikka.sui" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoVerse">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            tools:targetApi="24">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Binds as a notification listener solely because the platform gates
            media-session access behind that binding. The implementation is
            empty: notifications are never read, stored, or forwarded.
        -->
        <service
            android:name=".core.media.AutoVerseMediaListenerService"
            android:exported="true"
            android:label="@string/media_access_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
            <!-- Shizuku provider: lets AutoVerse talk to the Shizuku app
             (shell privileges via wireless debugging) for the map-display
             probe. No effect unless the user grants it. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
